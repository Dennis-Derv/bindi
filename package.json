{
  "name": "bindi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue.bold,green.bold\" \"npm run dev:server\" \"npm run dev:next\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "start:server": "tsx server/src/index.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "node node_modules/prisma/dist/prisma.js generate",
    "db:migrate": "node node_modules/prisma/dist/prisma.js migrate dev",
    "lint": "eslint"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.45.0",
    "multer": "^2.3.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
