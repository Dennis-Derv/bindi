// Prisma Schema for Bindir Knowledge Development Centre International (BKC)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERADMIN
}

enum MediaType {
  IMAGE
  VIDEO
}

enum InquiryType {
  GRANT
  SPONSORSHIP
  PARTNERSHIP
  DONATION
  GENERAL
}

enum InquiryStatus {
  PENDING
  REVIEWED
  CONTACTED
  ARCHIVED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  activities  Activity[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

model Activity {
  id                 String          @id @default(uuid())
  title              String
  slug               String          @unique
  summary            String?
  description        String
  date               DateTime        @default(now())
  location           String
  categoryId         String
  category           Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  impact             String?
  beneficiariesCount Int?
  beneficiariesLabel String?         @default("Beneficiaries Reached")
  partnersInvolved   String?
  isPublished        Boolean         @default(false)
  isFeatured         Boolean         @default(false)
  media              ActivityMedia[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("activities")
}

model Media {
  id            String          @id @default(uuid())
  title         String?
  filename      String
  url           String
  mediaType     MediaType       @default(IMAGE)
  mimeType      String?
  fileSize      Int?
  caption       String?
  category      String?
  isGallery     Boolean         @default(true)
  activityMedia ActivityMedia[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("media")
}

model ActivityMedia {
  id         String   @id @default(uuid())
  activityId String
  mediaId    String
  order      Int      @default(0)
  isCover    Boolean  @default(false)
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([activityId, mediaId])
  @@map("activity_media")
}

model Inquiry {
  id               String        @id @default(uuid())
  type             InquiryType   @default(GENERAL)
  organizationName String?
  contactName      String
  email            String
  phone            String?
  subject          String
  message          String
  proposedFunding  String?
  status           InquiryStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("inquiries")
}
